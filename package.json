{
  "name": "tempest-load",
  "version": "0.1.2",
  "description": "High-performance LLM & Streaming API Load Tester with Traffic Replay & CI/CD Performance Regression Checks",
  "type": "module",
  "bin": {
    "tempest-load": "./dist/index.js",
    "tempest": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhinavJain2107/tempest.git"
  },
  "homepage": "https://github.com/AbhinavJain2107/tempest#readme",
  "bugs": {
    "url": "https://github.com/AbhinavJain2107/tempest/issues"
  },
  "keywords": [
    "load-testing",
    "llm",
    "ai",
    "streaming",
    "sse",
    "ttft",
    "tokens-per-second",
    "benchmark",
    "regression",
    "har-replay"
  ],
  "author": "Abhinav Jain",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "string-width": "^8.2.2",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
